{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vku-ocr-expense",
  "compatibility_date": "2026-09-26",
  "observability": {
    "enabled": true
  },
  "main": "worker.js",
  "assets": {
    "directory": "web",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "EXPENSE_SYNC_KV",
      "id": "44361761f78e478182ec88cc867f7157"
    }
  ]
}
